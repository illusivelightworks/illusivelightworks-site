---
import Site from '../layouts/Site.astro';
import { site } from '../data/site';
const appStore = site.appStore;
const features = [
	{ title: 'Pick the art', text: 'A growing library of animations, real-time shaders and online videos, or bring your own media.', img: '/img/mac-slide1.png' },
	{ title: 'Precision alignment', text: 'Drag the four corners to fit walls, windows and objects exactly. Use as many grids as you need.', img: '/img/mac-slide2.png' },
	{ title: 'Different art in every shape', text: 'Additive and subtractive masks control exactly where visuals appear.', img: '/img/mac-slide3.png' },
	{ title: 'Warp it, tune it', text: 'Paint organic warps onto your art, then dial in color, speed and more.', img: '/img/mac-slide4.png' },
	{ title: 'Save it, share it, reuse it', text: 'Keep every setup by name and move projects between devices.', img: '/img/mac-slide5.png' },
];
---
<Site title="Illusive Lightworks | ILW Light Mapper" description="ILW Light Mapper is a real-time projection mapping app for iPhone, iPad and Mac. Align video to any surface, mask it, warp it and cast it.">
	<section class="hero">
		<img class="icon" src="/img/app-icon.png" alt="ILW Light Mapper app icon" width="120" height="120" />
		<h1>Pick the art.<br />Light up the room.</h1>
		<p>ILW Light Mapper is a real-time projection mapping app for iPhone, iPad and Mac. Fit video to walls, windows and objects, mask it, warp it and cast it to a projector.</p>
		<div class="buttons">
			<a class="cta" href={appStore}>Download on the App Store</a>
			<a class="ghost" href="/docs/">Read the guide</a>
		</div>
		<img class="shot" src="/img/mac-slide2.png" alt="Corner calibration in ILW Light Mapper on a Mac" />
	</section>

	<section class="features">
		{features.map((f, i) => (
			<article class={i % 2 ? 'row flip' : 'row'}>
				<div class="copy"><h2>{f.title}</h2><p>{f.text}</p></div>
				<img src={f.img} alt={f.title} loading="lazy" />
			</article>
		))}
	</section>

	<section class="docs-cta">
		<h2>See it in action</h2>
		<p>Short clips of real surfaces, real art and the app in use.</p>
		<a class="cta" href="/watch/">Watch</a>
	</section>

	<section class="docs-cta">
		<h2>Every tool, explained</h2>
		<p>Step-by-step guides for every screen and control, including the long-press tricks.</p>
		<a class="cta" href="/docs/">Open the documentation</a>
	</section>

</Site>

<style is:global>
	.hero { text-align:center; padding:48px 24px 24px; max-width:1000px; margin:0 auto; }
	.hero .icon { border-radius:26px; }
	.hero h1 { font-size:clamp(2.4rem, 6vw, 4.2rem); line-height:1.05; margin:.4em 0 .3em; }
	.hero p { max-width:640px; margin:0 auto 24px; color:var(--muted); font-size:1.1rem; }
	.buttons { display:flex; gap:12px; justify-content:center; flex-wrap:wrap; }
	.shot { width:100%; max-width:900px; margin-top:36px; border-radius:16px; }
	.features { max-width:1100px; margin:40px auto; padding:0 24px; display:grid; gap:56px; }
	.row { display:grid; grid-template-columns: 1fr 1.4fr; gap:32px; align-items:center; }
	.row.flip { grid-template-columns: 1.4fr 1fr; }
	.row.flip .copy { order:2; }
	.row img { width:100%; border-radius:14px; border:1px solid var(--line); }
	.row h2 { font-size:1.8rem; margin:0 0 .3em; }
	.row p { color:var(--muted); font-size:1.05rem; }
	.docs-cta { text-align:center; padding:56px 24px; background:var(--panel); border-top:1px solid var(--line); border-bottom:1px solid var(--line); }
	.docs-cta p { color:var(--muted); }
	@media (max-width: 760px) {
		.row, .row.flip { grid-template-columns: 1fr; }
		.row.flip .copy { order:0; }
		}
</style>
